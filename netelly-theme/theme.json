{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "ink", "color": "#121211", "name": "Ink" },
				{ "slug": "paper", "color": "#fbfaf7", "name": "Paper" },
				{ "slug": "cream", "color": "#f4f3ef", "name": "Cream" },
