				{ "slug": "muted", "color": "#6e6d69", "name": "Muted" }
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"fontFamilies": [
				{ "slug": "jp", "name": "Zen Kaku Gothic New", "fontFamily": "'Zen Kaku Gothic New', sans-serif" },
				{ "slug": "en", "name": "Archivo", "fontFamily": "'Archivo', sans-serif" },
				{ "slug": "mono", "name": "IBM Plex Mono", "fontFamily": "'IBM Plex Mono', monospace" }
			]
		}
