# Session β — 環境変数
# `.env.local` にコピーして値を入れる（.env*.local は .gitignore 済み）。

# --- バックエンド（未設定なら端末内で完結し、ユーザー間の同期は行われない）---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- 年齢確認プロバイダ（未設定なら Session ON / Request / Chat が使えない）---
# 確認セッションを開始する URL。?reference= と ?redirect_uri= が付与される。
EXPO_PUBLIC_AGE_VERIFICATION_URL=

# --- 任意 ---
# 1 にすると開発環境でも fixture ユーザーを投入しない。
EXPO_PUBLIC_DISABLE_FIXTURES=
