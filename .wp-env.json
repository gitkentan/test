{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.2",
  "port": 8888,
  "testsPort": 8889,
  "themes": [
    "./netelly-theme"
  ],
  "plugins": [
    "https://downloads.wordpress.org/plugin/secure-custom-fields.zip",
    "https://downloads.wordpress.org/plugin/polylang.zip",
    "https://downloads.wordpress.org/plugin/snow-monkey-forms.zip"
  ],
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "WP_ENVIRONMENT_TYPE": "local"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli wp language core install ja --activate && wp-env run cli wp language plugin install --all ja && wp-env run cli wp theme activate netelly-theme && wp-env run cli wp rewrite structure '/news/%post_id%/' --hard"
  },
  "mappings": {
    "wp-content/mu-plugins/netelly-local-mail.php": "./dev/netelly-local-mail.php"
  }
}
